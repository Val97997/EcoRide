{% extends 'base.html.twig' %}
{% block javascripts %}
  
{% endblock javascripts %}

{% block title %} Edit Profile {% endblock title %}
{% block body %}
  {# {{ form_start(registrationForm) }} #}
    <div class="bg-profile">

</div>

<section class="profile m-auto pt-5 pb-5">
    <div class="profile-row-1 m-auto">
        <span>{{form_row(registrationForm.pseudo)}}</span>
        <img src="{{asset('profile_pics/%s.jpg'|format(app.user.pseudo))}}" alt="Profile" style="height: 20rem; width: 20rem;">
        <span>{{form_row(registrationForm.email)}}</span>
    </div>

    <div class="profile-body mt-5 p-3">
        
        <div class="profile-row-2 ps-5 pe-5 btn btn-primary">
            <span><i class="bi bi-person-vcard me-2"></i>{{form_row(registrationForm.first_name)}} {{form_row(registrationForm.last_name)}}</span>

            <span><i class="bi bi-cake-fill me-2"></i> {{form_row(registrationForm.birth_date)}}</span>
            <span><i class="bi bi-geo-fill me-2"></i>{{form_row(registrationForm.address)}}</span>
            <span><i class="bi bi-telephone-fill me-2"></i>{{form_row(registrationForm.phone_nb)}}</span>
        </div>
        <div class="profile-row-3">
            
            {{form_row(registrationForm.picture)}}
                
        </div>
            
      </div>
        
        
        <a href="{{path('app_user_profile')}}" class="fs-2 btn btn-dark text-danger mt-2 btn-edit-profile">Update</a>

        {# {{form_rest(registrationForm)}}
  {{ form_end(registrationForm) }} #}
{% endblock body %}